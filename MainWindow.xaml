<Window x:Class="CybersafetyChatbotPart3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot - Part 3"
        Height="750" Width="1000"
        MinHeight="650" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Window.Resources>

        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00FF88"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00CC6A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#009950"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CaretBrush" Value="#00FF88"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00FF88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#00FF88"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#00FF88"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00FF88"/>
                                <Setter Property="Foreground" Value="#0D1117"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#00FF88" Margin="0,0,8,0"/>
                    <TextBlock Text="🔐 Cybersecurity Awareness Bot"
                               Foreground="#E6EDF3" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnClear" Content="Clear Chat" Style="{StaticResource HeaderButtonStyle}"
                            Click="BtnClear_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnExit" Content="Exit" Style="{StaticResource HeaderButtonStyle}"
                            Click="BtnExit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ASCII LOGO -->
        <Border Grid.Row="1" Background="#0D1117" Padding="10,8,10,4">
            <TextBlock FontFamily="Courier New"
                       FontSize="11"
                       Foreground="#00FF88"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="  ██╗  ██╗ █████╗ ███╗   ███╗ ██████╗ &#10;  ██║ ██╔╝██╔══██╗████╗ ████║██╔═══██╗&#10;  █████╔╝ ███████║██╔████╔██║██║   ██║&#10;  ██╔═██╗ ██╔══██║██║╚██╔╝██║██║   ██║&#10;  ██║  ██╗██║  ██║██║ ╚═╝ ██║╚██████╔╝&#10;  ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚═╝ ╚═════╝ "/>
        </Border>

        <!-- QUICK ACTION BUTTONS -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <TextBlock Text="Quick Actions: " Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="4,2"/>
                <Button Content="📋 View Tasks" Style="{StaticResource QuickButtonStyle}" Click="BtnViewTasks_Click"/>
                <Button Content="➕ Add Task" Style="{StaticResource QuickButtonStyle}" Click="BtnAddTask_Click"/>
                <Button Content="🎮 Start Quiz" Style="{StaticResource QuickButtonStyle}" Click="BtnStartQuiz_Click"/>
                <Button Content="📜 Activity Log" Style="{StaticResource QuickButtonStyle}" Click="BtnActivityLog_Click"/>
                <Button Content="❓ Help" Style="{StaticResource QuickButtonStyle}" Click="BtnHelp_Click"/>
            </WrapPanel>
        </Border>

        <!-- CHAT AREA -->
        <Border Grid.Row="3" Background="#0D1117" Margin="16,8,16,0">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChatPanel" Margin="0,8"/>
            </ScrollViewer>
        </Border>

        <!-- INPUT AREA -->
        <Border Grid.Row="4" Background="#161B22" BorderBrush="#21262D"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtInput"
                         Grid.Column="0"
                         Style="{StaticResource InputStyle}"
                         KeyDown="TxtInput_KeyDown"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         Height="44"/>

                <Button x:Name="BtnSend"
                        Grid.Column="1"
                        Content="Send"
                        Style="{StaticResource SendButtonStyle}"
                        Click="BtnSend_Click"
                        Height="44" Width="80"/>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="5" Background="#161B22" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Grid.Column="0"
                           Text="Type a message and press Enter or click Send"
                           Foreground="#8B949E" FontSize="11"/>

                <TextBlock x:Name="TxtMemory" Grid.Column="1"
                           Foreground="#8B949E" FontSize="11"/>
            </Grid>
        </Border>

    </Grid>
</Window>